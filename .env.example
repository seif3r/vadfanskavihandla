# Copy to .env.local (git-ignored) and fill in. See docs/setup.md.
# The Firebase web config: Firebase console > Project settings > Your apps > Web app.
# These are public by design; the Security Rules protect the data.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: App Check on web, with a reCAPTCHA Enterprise site key registered in the Firebase console.
EXPO_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Optional, development builds only: use the local emulators (firebase emulators:start).
# localhost for web, 10.0.2.2 for the Android emulator.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
