{
  "name": "vadfanskavihandla",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest --selectProjects app",
    "test:rules": "firebase emulators:exec --only firestore --project demo-vadfanskavihandla \"jest --selectProjects rules --runInBand\"",
    "test:functions": "npm --prefix functions run copy-locales && firebase emulators:exec --only firestore --project demo-vadfanskavihandla \"npm --prefix functions test\"",
    "test:all": "npm test && npm run test:rules && npm run test:functions"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.33",
    "expo-constants": "~57.0.24",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.14",
    "expo-notifications": "~57.0.25",
    "expo-router": "~57.0.31",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "firebase": "^13.0.0",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "firebase-tools": "^15.36.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "postcss": "^8.5.29",
    "brace-expansion@^1.1.0": "^1.1.21"
  }
