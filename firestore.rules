rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function list(listId) {
      return get(/databases/$(database)/documents/lists/$(listId));
    }
    function isMember(listId) {
      return signedIn() && uid() in list(listId).data.members;
    }
    function changes() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Private: email and settings.
    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
      match /pushTokens/{token} {
        allow read, write: if signedIn() && uid() == userId;
      }
    }

    // Public name, so others can see who added what.
    // "get" only: ids can be looked up but the collection can't be listed.
    match /profiles/{userId} {
      allow get: if signedIn();
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(['name']);
    }

    match /lists/{listId} {
      allow read: if signedIn() && uid() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && request.resource.data.members == [uid()];
      allow update: if signedIn() && (
        // Members may rename the list.
        (uid() in resource.data.members && changes().hasOnly(['name']))
        // Anyone with a valid invite may add themselves, and only themselves.
        || (changes().hasOnly(['members', 'invite'])
            && request.resource.data.members == resource.data.members.concat([uid()])
            && get(/databases/$(database)/documents/invites/$(request.resource.data.invite))
                 .data.listId == listId)
        // Members may leave.
        || (uid() in resource.data.members && changes().hasOnly(['members'])
            && request.resource.data.members == resource.data.members.removeAll([uid()]))
      );
      allow delete: if signedIn() && resource.data.ownerId == uid();
    }

    match /items/{itemId} {
      allow read, delete: if isMember(resource.data.listId);
      allow create: if isMember(request.resource.data.listId)
        && request.resource.data.addedBy == uid()
        && request.resource.data.updatedBy == uid();
      allow update: if isMember(resource.data.listId)
        && request.resource.data.listId == resource.data.listId
        && request.resource.data.updatedBy == uid();
    }

    // Invite codes are long random document ids. Knowing one is the permission.
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if isMember(request.resource.data.listId)
        && request.resource.data.createdBy == uid();
      allow delete: if signedIn() && resource.data.createdBy == uid();
    }
  }
}
