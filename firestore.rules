rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function list(listId) {
      return get(/databases/$(database)/documents/lists/$(listId));
    }
    function group(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId));
    }
    // Lists belong to a group; its members can see and change all of them.
    function isGroupMember(groupId) {
      return signedIn() && uid() in group(groupId).data.members;
    }
    function isGroupOwner(groupId) {
      return signedIn() && group(groupId).data.ownerId == uid();
    }
    function isMember(listId) {
      return isGroupMember(list(listId).data.groupId);
    }
    function changes() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // Limits and categories match constants/limits.ts and the Category type.
    function validText(text, max) {
      return text is string && text.size() > 0 && text.size() <= max;
    }
    function validName(name) { return validText(name, 100); }
    function validListName(name) { return validText(name, 50); }
    function validPersonName(name) { return validText(name, 50); }
    function validGroupName(name) { return validText(name, 50); }
    function validEmail(email) { return validText(email, 254); }
    // May be empty: an amount is optional, and leaving the field empty is no amount.
    function validAmount(amount) { return amount is string && amount.size() <= 30; }
    function validCategory(category) {
      return category in ['produce', 'dairy', 'meat', 'bread', 'pantry',
                          'frozen', 'drinks', 'household', 'other'];
    }
    function validNewItem(item) {
      return item.keys().hasOnly(['listId', 'name', 'amount', 'category', 'done',
                                  'addedBy', 'updatedBy', 'createdAt'])
        && validName(item.name)
        && item.done == false
        && item.createdAt == request.time
        && (!('amount' in item) || validAmount(item.amount))
        && (!('category' in item) || validCategory(item.category));
    }

    // Settings match UserSettings in types/models.ts. Only the settings a write changes are
    // checked, so accounts saved with an older shape can still change the others.
    function validNotifications(n) {
      return n is map && n.keys().hasOnly(['itemAdded', 'itemRemoved'])
        && n.get('itemAdded', false) is bool && n.get('itemRemoved', false) is bool;
    }
    function validSettings(next, prev) {
      let changed = next.diff(prev).affectedKeys();
      return next is map
        && changed.hasOnly(['language', 'theme', 'notifications'])
        && (!('language' in changed) || next.language in ['sv', 'en'])
        && (!('theme' in changed) || next.theme in ['system', 'light', 'dark'])
        && (!('notifications' in changed) || validNotifications(next.notifications));
    }

    // Private: email and settings.
    match /users/{userId} {
      allow read, delete: if signedIn() && uid() == userId;
      allow create: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(['name', 'email', 'settings'])
        && validPersonName(request.resource.data.name)
        && validEmail(request.resource.data.email)
        && request.resource.data.settings.keys().hasAll(['language', 'theme', 'notifications'])
        && validSettings(request.resource.data.settings, {});
      // The email is the one the account was created with; Firebase Auth owns changes to it.
      allow update: if signedIn() && uid() == userId
        && changes().hasOnly(['name', 'settings'])
        && validPersonName(request.resource.data.name)
        && (!('settings' in changes())
            || validSettings(request.resource.data.settings, resource.data.get('settings', {})));

      // One document per device, named by its Expo push token. Only installed Android/iOS
      // builds get push, so web never writes here.
      match /pushTokens/{token} {
        allow read, delete: if signedIn() && uid() == userId;
        allow create, update: if signedIn() && uid() == userId
          && token.size() <= 200
          && token.matches('^(Exponent|Expo)PushToken\\[[^\\]]+\\]$')
          && request.resource.data.keys().hasOnly(['platform', 'updatedAt'])
          && request.resource.data.platform in ['android', 'ios']
          && request.resource.data.updatedAt == request.time;
      }
    }

    // Public name, so others can see who added what.
    // "get" only: ids can be looked up but the collection can't be listed.
    match /profiles/{userId} {
      allow get: if signedIn();
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(['name'])
        && validPersonName(request.resource.data.name);
    }

    match /groups/{groupId} {
      allow read: if signedIn() && uid() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'members', 'createdAt'])
        && validGroupName(request.resource.data.name)
        && request.resource.data.createdAt == request.time
        && request.resource.data.ownerId == uid()
        && request.resource.data.members == [uid()];
      allow update: if signedIn() && (
        // The owner may rename the group (renameGroup in api/groups.ts).
        (resource.data.ownerId == uid() && changes().hasOnly(['name'])
            && validGroupName(request.resource.data.name))
        // Nobody can add themselves here: joining goes through the joinGroup Cloud Function.
        // Members may leave (leaveGroup). An owner who leaves hands the group to the next member;
        // the last member can't leave (members[0] doesn't exist), only delete.
        || (uid() in resource.data.members && changes().hasOnly(['members', 'ownerId'])
            && request.resource.data.members == resource.data.members.removeAll([uid()])
            && request.resource.data.ownerId == (resource.data.ownerId == uid()
                 ? request.resource.data.members[0] : resource.data.ownerId))
        // The owner may remove one other member (removeMember). They're remembered, so that
        // joinGroup won't let them back in with an invite code they still know.
        || (resource.data.ownerId == uid() && changes().hasOnly(['members', 'removedMembers'])
            && request.resource.data.members.size() == resource.data.members.size() - 1
            && resource.data.members.hasAll(request.resource.data.members)
            && uid() in request.resource.data.members
            && request.resource.data.removedMembers == resource.data.get('removedMembers', [])
                 .concat(resource.data.members.removeAll(request.resource.data.members)))
        // The owner may let one removed person be invited again (allowRemovedMember).
        || (resource.data.ownerId == uid() && changes().hasOnly(['removedMembers'])
            && request.resource.data.removedMembers.size() == resource.data.removedMembers.size() - 1
            && resource.data.removedMembers.hasAll(request.resource.data.removedMembers))
      );
      // Its lists and invites are deleted by a Cloud Function (cleanUpGroup).
      allow delete: if signedIn() && resource.data.ownerId == uid();
    }

    match /lists/{listId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'groupId', 'ownerId', 'createdAt'])
        && validListName(request.resource.data.name)
        && request.resource.data.createdAt == request.time
        && request.resource.data.ownerId == uid()
        && isGroupMember(request.resource.data.groupId);
      // Members may rename a list. It can't move to another group.
      allow update: if isGroupMember(resource.data.groupId)
        && changes().hasOnly(['name'])
        && validListName(request.resource.data.name);
      // Whoever created the list, or the group's owner. Its items are deleted by a Cloud
      // Function (cleanUpList).
      allow delete: if isGroupMember(resource.data.groupId)
        && (resource.data.ownerId == uid() || group(resource.data.groupId).data.ownerId == uid());

      // The category each item name last had on this list, to suggest it next time.
      match /knownItems/{key} {
        allow read, delete: if isMember(listId);
        allow create, update: if isMember(listId)
          && request.resource.data.keys().hasOnly(['name', 'category'])
          && validName(request.resource.data.name)
          && validCategory(request.resource.data.category);
      }
    }

    match /items/{itemId} {
      allow read, delete: if isMember(resource.data.listId);
      allow create: if isMember(request.resource.data.listId)
        && validNewItem(request.resource.data)
        && request.resource.data.addedBy == uid()
        && request.resource.data.updatedBy == uid();
      // The app only checks and unchecks items, so nothing else may change: not the
      // name, and not addedBy (no making it look like someone else added it).
      allow update: if isMember(resource.data.listId)
        && changes().hasOnly(['done', 'updatedBy'])
        && request.resource.data.done is bool
        && request.resource.data.updatedBy == uid();
    }

    // Invite codes to a group are random document ids. Only the joinGroup Cloud Function uses
    // them, and it checks that the code is still valid. It expires based on createdAt, which is
    // set by the server here, so a client can't choose how long a code lasts.
    match /invites/{code} {
      allow read: if isGroupOwner(resource.data.groupId);
      allow create: if isGroupMember(request.resource.data.groupId)
        && code.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(['groupId', 'groupName', 'createdBy', 'createdAt'])
        && validGroupName(request.resource.data.groupName)
        && request.resource.data.createdBy == uid()
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn()
        && (resource.data.createdBy == uid() || isGroupOwner(resource.data.groupId));
    }
  }
}
